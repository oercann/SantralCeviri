# /etc/ceviri.env — kopyalayıp doldur
# --- SIP trunk (Telnyx: SIP Connection > Credentials) ---
TRUNK_HOST=sip.telnyx.com
TRUNK_USER=telnyx_kullanici
TRUNK_PASS=telnyx_sifre
# Telnyx'ten alınan ABD numaran
MY_DID=+12015550123
# Kendi cep numaran (giriş yetkisi için)
MY_CELL=+12015559999

# --- Asterisk ARI ---
ARI_URL=http://127.0.0.1:8088
ARI_USER=ceviri
ARI_PASS=degistir_bunu

# --- Çeviri API'leri ---
OPENAI_API_KEY=sk-...
STT_MODEL=gpt-4o-mini-transcribe
TRANSLATE_MODEL=gpt-4o-mini
TTS_MODEL=tts-1
TTS_VOICE_EN=alloy
TTS_VOICE_TR=nova

# --- Uygulama ---
WEB_PORT=8443
# PWA giriş anahtarı
WEB_TOKEN=uzun_rastgele_sifre
RTP_HOST=127.0.0.1
RTP_PORT_BASE=40000
PUBLIC_IP=

# --- Güvenlik ---
# Cebinden arayınca tuşlanacak PIN (4-6 hane)
ACCESS_PIN=4821
# PWA Cloudflare Pages'ta ise origin
ALLOWED_ORIGIN=https://ceviri.pages.dev

# --- Gerçek zamanlı ses→ses (v2) ---
# gpt-realtime (kaliteli) | gpt-realtime-mini (daha ucuz/hızlı)
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
