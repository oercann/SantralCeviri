# /etc/ceviri.env — kopyalayıp doldur
# --- SIP trunk (Telnyx: SIP Connection > Credentials) ---
TRUNK_HOST=sip.telnyx.com
TRUNK_USER=telnyx_kullanici
TRUNK_PASS=telnyx_sifre
MY_DID=+12015550123          # Telnyx'ten alınan ABD numaran
MY_CELL=+12015559999         # Kendi cep numaran (giriş yetkisi için)

# --- Asterisk ARI ---
ARI_URL=http://127.0.0.1:8088
ARI_USER=ceviri
ARI_PASS=degistir_bunu

# --- Çeviri API'leri ---
OPENAI_API_KEY=sk-...
STT_MODEL=gpt-4o-mini-transcribe
TRANSLATE_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE_EN=alloy
TTS_VOICE_TR=nova

# --- Uygulama ---
WEB_PORT=8443
WEB_TOKEN=uzun_rastgele_sifre     # PWA giriş anahtarı
RTP_HOST=127.0.0.1
RTP_PORT_BASE=40000
PUBLIC_IP=

# --- Güvenlik ---
ACCESS_PIN=4821               # Cebinden arayınca tuşlanacak PIN (4-6 hane)
ALLOWED_ORIGIN=https://ceviri.pages.dev   # PWA Cloudflare Pages'ta ise origin
